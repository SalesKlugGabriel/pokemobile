; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format allows making changes.
;
; Format:
;   [section] ; section goes in []
;   key=value ; value goes to setting key
;   strings are always single-quoted
;   numbers are not quoted

config_version=5

[application]

config/name="PokéMobile"
config/description="Action RPG Top-Down baseado em Kanto — mundo aberto, single-player, desktop"
run/main_scene="res://scenes/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://assets/icons/icon.png"

[autoload]

GameData="*res://scripts/autoloads/GameData.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"
EventBus="*res://scripts/autoloads/EventBus.gd"
RNGManager="*res://scripts/autoloads/RNGManager.gd"
WorldManager="*res://scripts/world/WorldManager.gd"
BattleManager="*res://scripts/battle/BattleManager.gd"
SceneTransition="*res://scripts/autoloads/SceneTransition.gd"
AudioManager="*res://scripts/autoloads/AudioManager.gd"
KeybindManager="*res://scripts/autoloads/KeybindManager.gd"
QuestManager="*res://scripts/systems/QuestManager.gd"
GlobalUI="*res://scenes/ui/GlobalUI.tscn"

[application]

boot_splash/image="res://assets/icons/splash.png"
boot_splash/bg_color=Color(0.04, 0.04, 0.1, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

